# GraphQL backend used by /api/quote (CreateDemoRequest mutation)
# Public production origin used to generate canonical and sitemap URLs.
NEXT_PUBLIC_SITE_URL=https://aibqs.com
# Optional GA4 web stream ID. Leave blank until the owner supplies a verified ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Optional search-console verification values. Obtain them from the verified owner accounts.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Server-side override (preferred in deployment):
# GRAPHQL_API_URL=https://app.pmspace.ai/backend/graphql

# Public fallback matching aibizmod-service-web:
NEXT_PUBLIC_GRAPHQL_URL=https://app.pmspace.ai/backend/graphql

GRAPHQL_API_URL=https://app.pmspace.ai/backend/graphql
